{
  "name": "@coralswap/sdk",
  "version": "x.1.0",
  "description": "TypeScript SDK for CoralSwap -- contract-first AMM on Stellar/Soroban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:rwa": "jest --config jest.integration.config.js tests/integration/rwa.integration.test.ts",
    "test:integration:portfolio": "jest --config jest.integration.config.js --testPathPattern=portfolio.integration",
    "test:integration:limit-orders": "jest --config jest.integration.config.js --testPathPattern=limit-orders.integration",
    "test:integration:price-feed": "jest --config jest.integration.config.js --testPathPattern=price-feed.integration",
    "test:integration:flash-loan": "jest --config jest.integration.config.js --testPathPattern=flash-loan.integration",
    "test:integration:health-check": "jest --config jest.integration.config.js --testPathPattern=health-check.integration",
    "test:integration:liquidity": "jest --config jest.integration.config.js --testPathPattern=liquidity.integration",
    "test:integration:positions": "jest --config jest.integration.config.js --testPathPattern=positions.integration",
    "test:integration:fees": "jest --config jest.integration.config.js --testPathPattern=fees.integration",
    "test:integration:leaderboard": "jest --config jest.integration.config.js --testPathPattern=leaderboard.integration",
    "test:integration:router": "jest --config jest.integration.config.js --testPathPattern=router.integration",
    "test:integration:tokens": "jest --config jest.integration.config.js --testPathPattern=tokens.integration",
    "test:integration:treasury": "jest --config jest.integration.config.js --testPathPattern=treasury.integration",
    "test:integration:squid": "jest --config jest.integration.config.js --testPathPattern=squid.integration",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "examples:simple-swap": "ts-node examples/simple-swap.ts",
    "examples:provide-liquidity": "ts-node examples/provide-liquidity.ts",
    "examples:read-reserves": "ts-node examples/read-reserves.ts",
    "examples:alert-setup": "ts-node --transpile-only --require tsconfig-paths/register examples/alert-setup.ts",
    "examples:rwa-pool": "ts-node examples/rwa-pool.ts",
    "examples:governance-vote": "ts-node examples/governance-vote.ts",
    "docs": "typedoc",
    "fuzz": "jest --testPathPattern=fuzz --no-coverage",
    "benchmark": "ts-node benchmarks/run.ts",
    "load-test": "ts-node benchmarks/load-test.ts",
    "load-test:report": "ts-node benchmarks/load-test.ts --output benchmarks/load-test-report.json"
  },
  "keywords": [
    "coralswap",
    "stellar",
    "soroban",
    "dex",
    "defi",
    "amm",
    "sdk",
    "typescript"
  ],
  "author": "CoralSwap Finance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoralSwap-Finance/coralswap-sdk.git"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
